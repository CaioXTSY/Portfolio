---
import BackgroundGrid from '../ui/BackgroundGrid.astro';
import CornerDecorations from '../ui/CornerDecorations.astro';
import ScrollIndicator from '../ui/ScrollIndicator.astro';
import { siteConfig } from '../../data/navigation';
---

<section id="home" class="w-full min-h-screen flex flex-col items-center justify-center gap-8 px-5 py-24 relative bg-[#fafafa] overflow-hidden snap-start sm:gap-10 sm:px-10">
  <BackgroundGrid variant="light" />
  <CornerDecorations variant="light" />
  <p class="relative z-10 flex items-center gap-3 text-[0.7rem] font-semibold tracking-[0.2em] text-[#e63946] uppercase sm:-ml-20">
    <span class="h-px w-8 bg-[#e63946]"></span>
    Developer · Brazil
  </p>
  <div class="flex flex-col items-center text-center relative z-10 sm:-ml-20">
    <div class="flex items-stretch justify-center">
      <span class="font-display text-5xl font-bold text-[#18181b] tracking-[-0.06em] leading-[0.9] sm:text-[clamp(5.5rem,12vw,10.5rem)]">{siteConfig.firstName}</span>
    </div>
    <span class="font-display text-xl font-medium text-[#52525b] tracking-[0.18em] uppercase mt-3 sm:text-[clamp(1.8rem,4.5vw,3.6rem)] sm:tracking-[0.28em]">{siteConfig.lastName}</span>
  </div>
  <div class="flex flex-col items-center gap-6 relative z-10 sm:-ml-20">
    <div class="flex items-center gap-2 scale-75 sm:scale-100">
      <span class="w-1.5 h-1.5 bg-red-500/50 rounded-full"></span>
      <span class="w-5 h-px bg-red-500/40 sm:w-10"></span>
      <span class="w-px h-5 bg-red-500/60"></span>
      <span class="w-3 h-3 bg-red-500 rotate-45"></span>
      <span class="w-px h-5 bg-red-500/60"></span>
      <span class="w-5 h-px bg-red-500/40 sm:w-10"></span>
      <span class="w-1.5 h-1.5 bg-red-500/50 rounded-full"></span>
    </div>
    <div class="flex items-center gap-4">
      <span class="w-[30px] h-px bg-red-500/60"></span>
      <span class="text-xs font-medium text-gray-500 tracking-[0.15em] px-2 sm:text-base sm:tracking-[0.3em] lang-text" data-key="hero.title">{siteConfig.role}</span>
      <span class="w-[30px] h-px bg-red-500/60"></span>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-3 relative z-10 sm:-ml-20">
    <a href="#professional" class="inline-flex min-h-11 items-center gap-3 bg-[#18181b] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#e63946]">
      View selected work
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" /></svg>
    </a>
    <a href="#contact" class="inline-flex min-h-11 items-center border border-[#d4d4d8] px-5 py-3 text-sm font-semibold text-[#18181b] transition-colors hover:border-[#e63946] hover:text-[#e63946]">Let's work together</a>
    <button
      data-lang="pt"
      class="language-btn-mobile active min-h-11 px-3 py-1 text-sm font-semibold text-black transition-colors duration-300 border border-gray-300 hover:border-[#e63946] hover:text-[#e63946]"
      title="Português"
    >
      PT
    </button>
    <button
      data-lang="en"
      class="language-btn-mobile min-h-11 px-3 py-1 text-sm font-semibold text-gray-400 transition-colors duration-300 border border-gray-300 hover:border-[#e63946] hover:text-[#e63946]"
      title="English"
    >
      EN
    </button>
  </div>

  <ScrollIndicator />
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const languageBtnsMobile = document.querySelectorAll('.language-btn-mobile');
    const storedLang = localStorage.getItem('language') || 'pt';

    languageBtnsMobile.forEach(btn => {
      const lang = btn.getAttribute('data-lang');
      if (lang === storedLang) {
        btn.classList.add('active');
        btn.classList.remove('text-gray-400', 'border-gray-300');
        btn.classList.add('text-black', 'border-[#e63946]');
      } else {
        btn.classList.remove('active');
        btn.classList.add('text-gray-400', 'border-gray-300');
        btn.classList.remove('text-black', 'border-[#e63946]');
      }

      btn.addEventListener('click', () => {
        localStorage.setItem('language', lang || 'en');
        window.dispatchEvent(new CustomEvent('languageChange', { detail: lang }));

        languageBtnsMobile.forEach(b => {
          const bLang = b.getAttribute('data-lang');
          if (bLang === lang) {
            b.classList.add('active');
            b.classList.remove('text-gray-400', 'border-gray-300');
            b.classList.add('text-black', 'border-[#e63946]');
          } else {
            b.classList.remove('active');
            b.classList.add('text-gray-400', 'border-gray-300');
            b.classList.remove('text-black', 'border-[#e63946]');
          }
        });
      });
    });
  });
</script>
