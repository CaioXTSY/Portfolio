---
import ProjectCard from '../ui/ProjectCard.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import BackgroundGrid from '../ui/BackgroundGrid.astro';
import SectionGuides from '../ui/SectionGuides.astro';
import { professionalProjects } from '../../data/projects';
---

<section id="professional" class="w-full min-h-screen relative bg-[#fafafa] snap-start overflow-hidden flex items-center justify-center py-24 px-4 md:px-8">
  <BackgroundGrid variant="light" size={60} />
  <SectionGuides />

  <div class="relative z-10 w-full max-w-6xl mx-auto pb-8">
    <SectionTitle
      label="PROJECTS"
      title="Professional"
      titleKey="projects.professional"
      highlight="Projects"
      highlightKey="projects.professional-highlight"
      subtitle="Enterprise solutions and client work"
      subtitleKey="projects.professional-description"
      variant="light"
      centered={false}
      titleBreak={true}
      highlightFirst={true}
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12 items-start">
      {professionalProjects.map((project) => (
        <ProjectCard
          project={project}
          featured={project.featured}
        />
      ))}
    </div>
  </div>
</section>
